<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <IsPackable>true</IsPackable>
    <PackageId>SodiumBindings</PackageId>
    <VersionPrefix>1.1.0</VersionPrefix>
    <Title>SodiumBindings</Title>
    <Authors>Egor Nikulin</Authors>
    <Description>Modern .NET bindings for libsodium cryptographic APIs.</Description>
    <Copyright>Copyright (c) 2026 Egor Nikulin</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/hexog/sodium-bindings</PackageProjectUrl>
    <RepositoryUrl>https://github.com/hexog/sodium-bindings.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>libsodium sodium cryptography encryption hashing signatures p-invoke</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="libsodium" Version="1.0.22" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SodiumBindings.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="SodiumBindings.Interop.Sodium" Static="True" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
